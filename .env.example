# Production template. For isolated local tests use .env.test.example instead.
# Keep secrets out of Git and out of VITE_* variables.
APP_ENV=production
APP_ORIGIN=https://madinatydeals.com
APP_PORT=3000
AUTH_SECRET=
# Exact socket peer IPs of trusted proxies; proxy must overwrite X-Forwarded-For.
TRUSTED_PROXY_IPS=

DATABASE_URL=postgresql://user:password@localhost:5432/madinaty_deals
POSTGRES_DB=madinaty_deals
POSTGRES_USER=madinaty
# Use a long URL-safe random password; Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=
RUN_SEED=false
ADMIN_EMAIL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

OBJECT_STORAGE_BUCKET=
# Empty for AWS S3; HTTPS endpoint for another S3-compatible provider.
OBJECT_STORAGE_ENDPOINT=
AWS_REGION=us-east-1
# Prefer an IAM role where available; otherwise use restricted bucket credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Leave blank for the recommended same-origin frontend/API deployment.
VITE_API_BASE_URL=
PAYMENT_GATEWAY=
PAYMENT_GATEWAY_SECRET=

# Optional browser push. Configure all three to enable subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
