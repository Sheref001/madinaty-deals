# Production template. For isolated local tests use .env.test.example instead.
# Keep secrets out of Git and out of VITE_* variables.
APP_ENV=production
APP_ORIGIN=https://madinatydeals.com
APP_PORT=3000
AUTH_SECRET=
# Exact socket peer IPs of trusted proxies, comma-separated; each proxy must overwrite X-Forwarded-For.
TRUSTED_PROXY_PEERS=127.0.0.1
DATABASE_URL=postgresql://user:password@localhost:5432/madinaty_deals
POSTGRES_DB=madinaty_deals
POSTGRES_USER=madinaty
# Use a long URL-safe random password; Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=
RUN_SEED=false
ADMIN_EMAIL=
REGISTRATION_ENABLED=false
COGNITO_ENABLED=false
COGNITO_ISSUER_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_CALLBACK_URL=https://madinatydeals.com/api/auth/cognito/callback
# Optional custom Cognito managed-login origin, for example https://auth.madinatydeals.com
COGNITO_DOMAIN_URL=

# On-demand user-content translation. Keep disabled until an AWS IAM identity
# with translate:TranslateText is configured for the server.
TRANSLATION_ENABLED=false
TRANSLATION_REGION=eu-north-1

# Amazon SES SMTP or another transactional provider: MAIL_PROVIDER=smtp.
# Microsoft 365 delegated Graph is available, but is not recommended for application OTP delivery.
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_TOKEN_FILE=/app/data/mail-auth/token.json

# Leave blank for the recommended same-origin frontend/API deployment.
VITE_API_BASE_URL=

# Enable only after the private S3 bucket and photo worker are configured.
PHOTO_STORAGE=local
S3_PHOTO_BUCKET=
S3_PHOTO_REGION=eu-north-1
