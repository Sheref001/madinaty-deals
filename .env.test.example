# Local integration services only; never use these values for a public deployment.
APP_ENV=local
APP_PORT=43187
APP_ORIGIN=http://localhost:43187
AUTH_SECRET=local-integration-secret-at-least-32-characters
POSTGRES_PASSWORD=localtestpassword
POSTGRES_USER=madinaty
POSTGRES_DB=madinaty_deals
RUN_SEED=true
ADMIN_EMAIL=admin@example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Madinaty Deals <noreply@example.test>
OBJECT_STORAGE_BUCKET=madinaty-private
OBJECT_STORAGE_ENDPOINT=http://storage:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-storage-user
AWS_SECRET_ACCESS_KEY=local-storage-password-only
CLAMAV_HOST=clamav
